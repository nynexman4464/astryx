{
  "name": "@astryxdesign/theme-windows98",
  "version": "0.7.14",
  "displayName": "Windows 98 Theme",
  "private": false,
  "description": "Windows 98-inspired theme with Windows Standard and Slate color schemes.",
  "author": "Meta Open Source",
  "license": "MIT",
  "homepage": "https://github.com/meta/astryx#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meta/astryx.git",
    "directory": "packages/themes/windows98"
  },
  "bugs": {
    "url": "https://github.com/meta/astryx/issues"
  },
  "keywords": [
    "astryx",
    "theme",
    "design-system",
    "windows98",
    "retro"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "main": "./dist/source.cjs",
  "types": "./dist/source.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/source.d.ts",
        "default": "./dist/source.mjs"
      },
      "require": {
        "types": "./dist/source.d.cts",
        "default": "./dist/source.cjs"
      }
    },
    "./built": {
      "types": "./dist/windows98.d.ts",
      "import": "./dist/windows98.js",
      "require": "./dist/windows98.js"
    },
    "./theme.css": {
      "types": "./theme.css.d.ts",
      "default": "./dist/theme.css"
    }
  },
  "files": [
    "dist",
    "src",
    "theme.css.d.ts",
    "!**/*.test.*",
    "!**/*.spec.js",
    "!**/*.spec.jsx",
    "!**/*.spec.mjs",
    "!**/*.spec.cjs",
    "!**/*.spec.ts",
    "!**/*.spec.tsx",
    "!**/*.spec.mts",
    "!**/*.spec.cts",
    "!**/*.spec.d.ts",
    "!**/__tests__/**",
    "!**/__mocks__/**",
    "!**/*.bench.*"
  ],
  "scripts": {
    "api:report": "node ../../../scripts/api-report/cli.mjs --package .",
    "build": "node ../../../scripts/clean-dist.mjs && astryx theme build src/windows98Theme.ts -o dist/theme.css --icons-specifier ./icons.mjs && tsup && tsc --project tsconfig.build.json && node ../../../scripts/add-declaration-extensions.mjs && node ../../../scripts/emit-commonjs-declarations.mjs dist/source.d.ts && node ../../../scripts/check-fully-specified.mjs"
  },
  "peerDependencies": {
    "@astryxdesign/core": "0.7.14",
    "react": ">=19"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.7.14"
  },
  "module": "./dist/source.mjs"
}
