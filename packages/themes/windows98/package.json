{
  "name": "@astryxdesign/theme-windows98",
  "version": "0.7.14",
  "displayName": "Windows 98 Theme",
  "private": false,
  "description": "Windows 98-inspired theme with Windows Standard and Slate color schemes.",
  "author": "Meta Open Source",
  "license": "MIT",
  "homepage": "https://github.com/facebook/astryx#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/facebook/astryx.git",
    "directory": "packages/themes/windows98"
  },
  "bugs": {
    "url": "https://github.com/facebook/astryx/issues"
  },
  "keywords": [
    "astryx",
    "theme",
    "design-system",
    "windows98",
    "retro"
  ],
  "sideEffects": false,
  "main": "./dist/source.js",
  "types": "./dist/source.d.ts",
  "exports": {
    ".": {
      "types": "./dist/source.d.ts",
      "import": "./dist/source.mjs",
      "require": "./dist/source.js"
    },
    "./built": {
      "types": "./dist/windows98.d.ts",
      "import": "./dist/windows98.js",
      "require": "./dist/windows98.js"
    },
    "./theme.css": {
      "types": "./theme.css.d.ts",
      "default": "./dist/theme.css"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "node ../../../scripts/clean-dist.mjs && astryx theme build src/windows98Theme.ts -o dist/theme.css && tsup && tsc --project tsconfig.build.json && node ../../../scripts/check-fully-specified.mjs"
  },
  "peerDependencies": {
    "@astryxdesign/core": "0.7.14",
    "react": ">=19"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.7.14",
    "@astryxdesign/core": "workspace:*"
  },
  "module": "./dist/source.mjs"
}
